{
  "name": "@pg-compass/desktop",
  "productName": "PG Compass",
  "version": "0.9.7",
  "description": "PostgreSQL database viewer desktop application",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.pglite.config.ts",
    "test:integration:postgres": "vitest run --config vitest.integration.postgres.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.e2e.spec.ts"
  },
  "keywords": [],
  "author": {
    "name": "Alan",
    "email": "alan_biju@outlook.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electric-sql/pglite": "0.3.5",
    "@electric-sql/pglite-socket": "^0.0.10",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.0.0",
    "@playwright/test": "^1.55.0",
    "@reforged/maker-appimage": "^5.2.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/leaflet": "^1.9.21",
    "@types/pg": "^8.18.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "40.9.3",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "8",
    "leaflet": "^1.9.4",
    "lossless-json": "4.2.0",
    "lucide-react": "^0.577.0",
    "pg": "^8.20.0",
    "pg-copy-streams": "^7.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "stream-json": "2.1.0",
    "tailwind-merge": "^3.3.0"
  }
}
