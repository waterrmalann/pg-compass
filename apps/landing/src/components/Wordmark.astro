---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { withBase } from "../lib/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href={withBase("")}
  class:list={[
    "inline-flex items-center gap-2 rounded-md text-sm font-medium tracking-[-0.01em] text-foreground",
    className,
  ]}
>
  <Image src={logo} alt="" width={24} height={24} densities={[1, 2]} class="size-6" />
  PG Compass
</a>
