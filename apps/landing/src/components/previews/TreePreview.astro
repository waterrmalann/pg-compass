---
import { ChevronRight, Database, Eye, Folder, Star, Table2 } from "@lucide/astro";
import { demoConnections, demoSchemas } from "../../lib/demo";

// The sidebar is rendered here; the tab strip and column list on the right
// are rendered by scripts/tree-preview.ts as tables are opened.
const rowClass =
  "relative flex h-7 w-full cursor-pointer items-center gap-1.5 rounded-md pr-1.5 text-left text-[12.5px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring";
---

<div class="preview" data-tree-preview>
  <div class="grid min-h-[23rem] sm:grid-cols-[12.5rem_minmax(0,1fr)]">
    <div class="border-b border-border bg-sidebar p-2 sm:border-r sm:border-b-0">
      {
        demoConnections.map((connection, connectionIndex) => (
          <div data-connection={connection.name}>
            {connectionIndex === 0 && <p class="mt-1 mb-1 px-2 text-xs text-muted-foreground">Favourites</p>}
            {connectionIndex === 1 && <p class="mt-4 mb-1 px-2 text-xs text-muted-foreground">Connections</p>}
            <button
              type="button"
              class:list={[rowClass, "h-8 pl-1 text-[13px] font-medium", connection.connected && "text-foreground"]}
              aria-expanded={connection.connected ? (connectionIndex === 0 ? "true" : "false") : undefined}
              data-toggle
              disabled={!connection.connected}
            >
              <ChevronRight
                class:list={[
                  "size-3 shrink-0 transition-transform duration-150 in-aria-expanded:rotate-90",
                  !connection.connected && "invisible",
                ]}
                aria-hidden="true"
              />
              <Database class="size-4 shrink-0" aria-hidden="true" />
              <span class="truncate">{connection.name}</span>
              {connection.color && (
                <span class="size-1.5 shrink-0 rounded-full" style={{ backgroundColor: connection.color }} aria-hidden="true" />
              )}
              {connection.favourite && (
                <Star class="ml-auto size-3 shrink-0 fill-current text-muted-foreground" aria-label="Favourite" />
              )}
            </button>
            {connection.connected && (
              <div class="ml-3 border-l border-border pl-1.5 [[aria-expanded=false]+&]:hidden">
                {demoSchemas.map((schema) => (
                  <div>
                    <button
                      type="button"
                      class:list={[rowClass, "pl-1"]}
                      aria-expanded={connectionIndex === 0 && schema.name === "shop" ? "true" : "false"}
                      data-toggle
                    >
                      <ChevronRight class="size-3 shrink-0 transition-transform duration-150 in-aria-expanded:rotate-90" aria-hidden="true" />
                      <Folder class="size-3.5 shrink-0" aria-hidden="true" />
                      <span class="truncate">{schema.name}</span>
                      <span class="ml-auto font-mono text-[11px] text-subtle-foreground">{schema.relations.length}</span>
                    </button>
                    <div class="ml-2.5 border-l border-border pl-1.5 [[aria-expanded=false]+&]:hidden">
                      {schema.relations.map((relation) => (
                        <button
                          type="button"
                          class:list={[rowClass, "pl-2 font-mono text-xs aria-pressed:bg-accent aria-pressed:text-foreground"]}
                          aria-pressed="false"
                          data-open-relation
                          data-connection-name={connection.name}
                          data-schema={schema.name}
                          data-relation={relation.name}
                        >
                          {relation.kind === "view" ? (
                            <Eye class="size-3.5 shrink-0" aria-hidden="true" />
                          ) : (
                            <Table2 class="size-3.5 shrink-0" aria-hidden="true" />
                          )}
                          <span class="truncate">{relation.name}</span>
                        </button>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div class="flex min-w-0 flex-col">
      <div
        class="relative flex h-10 shrink-0 items-center gap-1 overflow-x-auto border-b border-border bg-sidebar px-1.5 [scrollbar-width:none]"
        data-tab-strip
        role="list"
        aria-label="Open tabs"
      >
      </div>
      <div class="flex h-11 shrink-0 items-center gap-1.5 border-b border-border px-3 text-[13px]" data-breadcrumb></div>
      <div class="min-h-0 flex-1 overflow-auto p-3">
        <table class="w-full border-collapse text-[13px]">
          <thead>
            <tr>
              <th class="h-8 border-b border-border px-2 text-left text-xs font-medium text-muted-foreground">Column</th>
              <th class="h-8 border-b border-border px-2 text-left text-xs font-medium text-muted-foreground">Type</th>
              <th class="hidden h-8 border-b border-border px-2 text-left text-xs font-medium text-muted-foreground md:table-cell">
                Nullable
              </th>
            </tr>
          </thead>
          <tbody data-columns></tbody>
        </table>
      </div>
    </div>
  </div>
  <p class="preview-footer">Open a few tables. Tabs keep their connection's colour, so production never passes for staging.</p>
</div>

<script>
  import { setupTreePreview } from "../../scripts/tree-preview";
  setupTreePreview();
</script>
