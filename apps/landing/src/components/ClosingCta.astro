---
import { ArrowRight } from "@lucide/astro";
import { links } from "../lib/site";
---

<section class="border-t border-border py-20 md:py-28">
  <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
    <div>
      <h2 class="text-4xl leading-[1.06] font-medium tracking-[-0.025em] md:text-5xl">
        Open a database. Look around.
      </h2>
      <p class="mt-4 max-w-[34rem] text-lg leading-[1.7] text-muted-foreground">
        It takes a connection string and about a minute.
      </p>
    </div>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a class="btn btn-brand btn-xl" href={links.latestRelease} target="_blank" rel="noopener" data-download-primary>
        <span data-download-label>Download the latest release</span>
        <ArrowRight aria-hidden="true" />
      </a>
      <a class="btn btn-outline btn-xl" href="#download">All downloads</a>
    </div>
  </div>
</section>
