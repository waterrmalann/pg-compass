---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProductWindow from "../components/ProductWindow.astro";
import FeatureRow from "../components/FeatureRow.astro";
import TreePreview from "../components/previews/TreePreview.astro";
import DataPreview from "../components/previews/DataPreview.astro";
import QueryPreview from "../components/previews/QueryPreview.astro";
import ThemeCompare from "../components/ThemeCompare.astro";
import AlsoIncluded from "../components/AlsoIncluded.astro";
import Download from "../components/Download.astro";
import Faq from "../components/Faq.astro";
import OpenSource from "../components/OpenSource.astro";
import ClosingCta from "../components/ClosingCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Header />
  <main>
    <Hero />
    <ProductWindow />

    <div class="mx-auto mt-16 max-w-6xl px-6 md:mt-24">
      <section id="features" aria-label="Features">
        <FeatureRow eyebrow="Navigation" title="Schemas first. Every table one click away.">
          <p>
            Connections, schemas, tables and views live in one tree. Save a connection with a URI or
            separate fields, give it a label and a colour, and star the ones you open every day.
          </p>
          <p>Tabs keep their connection's colour, so a production tab never looks like a staging one.</p>
          <TreePreview slot="preview" />
        </FeatureRow>

        <FeatureRow eyebrow="Data" title="Rows or documents. Your call." reverse>
          <p>
            Page through a table 25 to 100 rows at a time and filter with a plain WHERE clause. When a
            table is mostly JSONB, switch to card view and read each row as a document.
          </p>
          <p>Double-click a cell to edit it, or insert, update and delete rows with a preview first.</p>
          <DataPreview slot="preview" />
        </FeatureRow>

        <FeatureRow eyebrow="Query" title="Ask in SQL. Read the answer.">
          <p>
            Every table has a Query tab with a highlighted SQL editor. Results land in the same grid,
            with the same pagination, card view and export.
          </p>
          <p>It only runs SELECT, so a stray DELETE stays in your clipboard.</p>
          <QueryPreview slot="preview" />
        </FeatureRow>

        <ThemeCompare />
        <AlsoIncluded />
      </section>

      <Download />
      <Faq />
      <OpenSource />
      <ClosingCta />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { hydrateGitHub } from "../scripts/github";
  hydrateGitHub();
</script>
