---
import "../styles/global.css";
import { withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "PG Compass: a fast, focused PostgreSQL viewer",
  description = "A small desktop app for looking inside PostgreSQL. Browse schemas, read rows, check indexes and run a quick query. Free and open source for Windows and Linux.",
} = Astro.props;

const ogImage = new URL(withBase("og.png"), Astro.site).href;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={withBase("favicon.png")} />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <!-- Dark is the default; a saved choice from the theme toggle wins. Runs
         before paint so the page never flashes the wrong theme. -->
    <script is:inline>
      try {
        if (localStorage.getItem("pgc-theme") === "light") {
          document.documentElement.classList.remove("dark");
        }
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
