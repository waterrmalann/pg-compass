{
  "name": "pg-compass",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:desktop": "turbo run dev --filter @pg-compass/desktop",
    "check:names": "node scripts/check-file-names.mjs",
    "audit:desktop": "node scripts/audit-desktop.mjs",
    "lint": "pnpm check:names && turbo run lint",
    "format": "prettier --write apps/desktop packages scripts package.json turbo.json pnpm-workspace.yaml \".github/workflows/*.yml\"",
    "format:check": "prettier --check apps/desktop packages scripts package.json turbo.json pnpm-workspace.yaml \".github/workflows/*.yml\"",
    "check-types": "turbo run check-types",
    "version:bump": "node scripts/bump-version.mjs",
    "make": "turbo run make",
    "test": "turbo run test --filter @pg-compass/desktop",
    "test:unit": "turbo run test:unit --filter @pg-compass/desktop",
    "test:integration": "turbo run test:integration --filter @pg-compass/desktop",
    "test:integration:postgres": "turbo run test:integration:postgres --filter @pg-compass/desktop",
    "test:e2e": "turbo run test:e2e --filter @pg-compass/desktop",
    "test:coverage": "turbo run test:coverage --filter @pg-compass/desktop",
    "test:watch": "turbo run test:watch --filter @pg-compass/desktop"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.2",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.5": "4.0.5"
    },
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "engines": {
    "node": ">=20.19"
  }
}



